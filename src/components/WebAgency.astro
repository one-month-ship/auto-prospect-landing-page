---
// Encart agence : met en avant l'offre de développement sur-mesure (N.dev),
// l'équipe qui a conçu Auto-Prospect — site vitrine, outils métier et
// automatisations. Utilisé sur l'accueil et sur /tarifs.
const { compact = false } = Astro.props;

// Trois offres : la vitrine (porte d'entrée), l'outil métier et l'automatisation.
const offers = [
  {
    tag: "Site vitrine",
    title: "Un site qui vous amène des clients",
    desc: "Vitrine, stock véhicules en ligne, formulaire de reprise, prise de rendez-vous. Conçu pour remonter sur Google, pas seulement pour exister.",
    points: ["Livré en 1 semaine", "Sur-mesure, pas un template", "SEO technique inclus"],
  },
  {
    tag: "Outil métier",
    title: "Le logiciel que votre activité réclame",
    desc: "Gestion de stock, suivi des ventes, tableau de bord, espace client, application interne. Quand aucun outil du marché ne colle vraiment à votre façon de travailler, on le construit.",
    points: ["Cahier des charges gratuit", "Développement par lots livrés", "Vous validez à chaque étape"],
  },
  {
    tag: "Automatisation",
    title: "Ce qui vous prend des heures, une fois pour toutes",
    desc: "Relances clients, saisie de données, publication d'annonces, rapports, synchronisation entre vos outils. Auto-Prospect est né exactement de ce raisonnement.",
    points: ["Audit du temps perdu", "Connexion à vos outils existants", "Rentabilisé en semaines"],
  },
];

// Arguments transversaux : ce qui vaut pour les trois offres.
const proofs = [
  {
    title: "La preuve est sous vos yeux",
    desc: "Auto-Prospect — le produit, le site, l'infrastructure — c'est nous. Vous jugez notre travail avant même de nous parler.",
  },
  {
    title: "On connaît votre métier",
    desc: "On a passé des mois dans la prospection auto, les annonces et les CRM. Pas besoin de nous expliquer votre quotidien.",
  },
  {
    title: "Prix annoncé, prix final",
    desc: "Devis fixe avant la première ligne de code. Pas de rallonge en cours de route, pas de frais surprise à la livraison.",
  },
  {
    title: "Vous restez propriétaire",
    desc: "Le code, les données, les accès : tout vous appartient. Aucune dépendance forcée, et on reste joignables après la livraison.",
  },
];
---

<section class={compact ? "py-12" : "py-20 sm:py-28"}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="fade-up relative overflow-hidden rounded-3xl border border-border bg-card p-8 sm:p-14">
      <div class="pointer-events-none absolute -right-20 -top-20 h-60 w-60 rounded-full bg-accent/10 blur-[80px]"></div>

      <div class="relative">
        <div class="mx-auto max-w-3xl text-center">
          <span class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-accent">
            Développement sur-mesure
          </span>
          <h2 class="mt-5 text-3xl font-bold sm:text-4xl">
            Site, outil métier, automatisation : on le construit pour vous.
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-text-secondary">
            Auto-Prospect est développé par <span class="font-semibold text-text">N.dev</span>, notre studio de
            développement. La même équipe conçoit votre site vitrine, l'outil interne qui vous manque, ou
            l'automatisation qui vous rendra vos heures — pour un garage, une concession, un mandataire ou
            toute autre activité.
          </p>
        </div>

        <!-- Les trois offres -->
        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {offers.map((o) => (
            <div class="flex flex-col rounded-2xl border border-border bg-bg/40 p-7 transition-colors hover:border-accent/30">
              <span class="self-start rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
                {o.tag}
              </span>
              <h3 class="mt-4 text-lg font-bold">{o.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-text-secondary">{o.desc}</p>
              <ul class="mt-5 space-y-2 border-t border-border pt-5">
                {o.points.map((pt) => (
                  <li class="flex items-start gap-2.5 text-sm">
                    <span class="mt-0.5 shrink-0 text-accent">✓</span>
                    <span class="text-text-secondary">{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Pourquoi nous -->
        <div class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2">
          {proofs.map((p) => (
            <div>
              <h4 class="flex items-start gap-2.5 text-base font-semibold">
                <span class="mt-0.5 shrink-0 text-accent">✓</span>
                {p.title}
              </h4>
              <p class="mt-2 pl-6 text-sm leading-relaxed text-text-secondary">{p.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-12 text-center">
          <a
            href="https://nassim-dev.netlify.app/fr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-xl bg-accent px-8 py-3.5 text-base font-semibold text-bg shadow-lg shadow-accent/25 transition-all hover:bg-accent-hover hover:shadow-accent/40"
          >
            Voir nos réalisations
          </a>
          <p class="mt-4 text-sm text-text-secondary">
            Devis gratuit sous 24h — et on vous dit franchement si vous n'en avez pas besoin.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
